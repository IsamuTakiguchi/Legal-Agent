# `python -m legal_agent setup` で対話的に生成できます（手で編集しても可）

# Anthropic API キー
ANTHROPIC_API_KEY=

# 使用モデルと推論の深さ（low / medium / high / xhigh / max）
LEGAL_AGENT_MODEL=claude-opus-5
LEGAL_AGENT_EFFORT=high

# 手持ち書籍 PDF のフォルダ（複数はカンマ区切り）。起動時と 1 時間ごとに自動で索引更新
LEGAL_AGENT_PDF_DIRS=/path/to/books

# 契約サービスの自動ログイン（空なら UI の「手動」ボタンでブラウザからログイン）
LEGAL_AGENT_TKC_USER=
LEGAL_AGENT_TKC_PASSWORD=

# LEGAL LIBRARY は利用規約第 8 条により既定ではアプリからアクセスしない（docs/TERMS_REVIEW.md）。
# 運営会社の許諾を得た場合のみ true にし、認証情報を設定する
LEGAL_AGENT_LEGAL_LIBRARY_ENABLED=false
LEGAL_AGENT_LEGAL_LIBRARY_USER=
LEGAL_AGENT_LEGAL_LIBRARY_PASSWORD=

# データ保存先（索引 DB・キャッシュ・セッション・メモ・ブラウザプロファイル・自動発見したセレクタ）
LEGAL_AGENT_DATA_DIR=./data

# 自動処理の切替（既定はすべて有効）
LEGAL_AGENT_AUTO_INDEX=true
LEGAL_AGENT_AUTO_LOGIN=true
LEGAL_AGENT_AUTO_OPEN_BROWSER=true
LEGAL_AGENT_AUTO_CONFIGURE=true

# サーバの待受（ローカル専用。0.0.0.0 にしないこと）
LEGAL_AGENT_HOST=127.0.0.1
LEGAL_AGENT_PORT=8765

# 自動ログイン時はブラウザ非表示でよい（手動ログイン時は自動で表示に切り替わる）
LEGAL_AGENT_HEADLESS=true

# 1 質問あたりの外部アクセス上限（利用規約配慮）
LEGAL_AGENT_MAX_SEARCHES_PER_SOURCE=3
LEGAL_AGENT_MAX_FETCHES_PER_RUN=6
LEGAL_AGENT_MIN_INTERVAL_SEC=1.0

# 1 にすると TKC / LEGAL LIBRARY 操作時の HTML とスクリーンショットを data/debug/ に保存
LEGAL_AGENT_DEBUG_DUMP=0
