# Anthropic API キー（`ant auth login` 済みなら未設定でも可）
ANTHROPIC_API_KEY=

# 使用モデルと推論の深さ（low / medium / high / xhigh / max）
LEGAL_AGENT_MODEL=claude-opus-5
LEGAL_AGENT_EFFORT=high

# 手持ち書籍 PDF のフォルダ（複数はカンマ区切り）
LEGAL_AGENT_PDF_DIRS=/path/to/books

# データ保存先（索引 DB・キャッシュ・セッション・メモ・ブラウザプロファイル）
LEGAL_AGENT_DATA_DIR=./data

# サーバの待受（ローカル専用。0.0.0.0 にしないこと）
LEGAL_AGENT_HOST=127.0.0.1
LEGAL_AGENT_PORT=8765

# TKC / LEGAL LIBRARY 用ブラウザ。ログイン操作のため通常は表示（false）
LEGAL_AGENT_HEADLESS=false

# 1 質問あたりの外部アクセス上限（利用規約配慮）
LEGAL_AGENT_MAX_SEARCHES_PER_SOURCE=3
LEGAL_AGENT_MAX_FETCHES_PER_RUN=6
LEGAL_AGENT_MIN_INTERVAL_SEC=1.0

# 1 にすると TKC / LEGAL LIBRARY 操作時の HTML とスクリーンショットを data/debug/ に保存
LEGAL_AGENT_DEBUG_DUMP=0
